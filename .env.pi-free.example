# Copy this file to .env.pi-free for local use.
# mise loads .env.pi-free directly for `mise run pi:free`.
# Use the canonical CLOUDFLARE_* variable names that pi-free already expects.

OPENROUTER_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
NVIDIA_API_KEY=
OLLAMA_API_KEY=
MISTRAL_API_KEY=

# The default free fallback shortlist currently targets OpenRouter, Cloudflare, NVIDIA,
# Ollama Cloud, and Mistral. Keep pi-free in free-only mode where it supports paid toggles.
PI_FREE_ONLY=true
OPENROUTER_SHOW_PAID=false
NVIDIA_SHOW_PAID=false
CLOUDFLARE_SHOW_PAID=false
OLLAMA_SHOW_PAID=false
